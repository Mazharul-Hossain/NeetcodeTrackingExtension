{
  "manifest_version": 3,
  "minimum_chrome_version": "157",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; form-action 'none'; base-uri 'none'"
  },
  "name": "NeetCode Tracking 2.0",
  "version": "2.0.0",
  "description": "Save NeetCode solutions and problem notes to GitHub with encrypted token storage and PIN-assisted unlock.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage", "scripting", "webRequest"],
  "host_permissions": ["https://api.github.com/*", "https://neetcode.io/*"],
  "content_scripts": [
    {
      "matches": ["https://neetcode.io/*"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {}
}
